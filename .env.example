# ── Bu faylni  .env  deb nusxalang va to'ldiring ──
# Telegram ID: har bir xodim botga /start yozsa, bot uning ID sini aytadi.

BOT_TOKEN=bu_yerga_BotFather_tokeni
BASE_URL=https://...                 # Cloudflare Tunnel bergan HTTPS manzil
REPORT_TIME=18:30

# OTK (2 kishi — тур'ни formaда o'zi tanlaydi)
OTK_ALU_ID=0
OTK_ALU_NAME=Нажмитдинов А.
OTK_PVH_ID=0
OTK_PVH_NAME=Нажмитдинов А.

# MASTER (тур bo'yicha)
MASTER_ALU_ID=0
MASTER_ALU_NAME=Мамаджанов А.
MASTER_PVH_ID=0
MASTER_PVH_NAME=Усмонов М.

# Зав.склад ГП (1 kishi)
GP_ID=0
GP_NAME=Нематуллаев Э.

# Operator (2) + Rahbar — yopilган PDF + kunlik hisobot shularга boradi
OPERATOR1_ID=0
OPERATOR2_ID=0
RAHBAR_ID=0
