[Unit]
Description=OTK Nakladnoy Bot
After=network.target

[Service]
Type=simple
User=Acer
WorkingDirectory=/home/Acer/otk-bot
Environment=TZ=Asia/Tashkent
ExecStart=/home/Acer/otk-bot/venv/bin/uvicorn server:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
